rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function hasVerifiedEmail() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function userDocExists(userId) {
      return exists(/databases/$(database)/documents/users/$(userId));
    }

    function hasCompletedOnboarding() {
      return signedIn()
        && userDocExists(request.auth.uid)
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.onboardingStatus == "complete";
    }

    function isAdmin() {
      return signedIn()
        && (
          request.auth.token.admin == true
          || (
            userDocExists(request.auth.uid)
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true
          )
        );
    }

    function isBanned(userId) {
      return userDocExists(userId)
        && (
          get(/databases/$(database)/documents/users/$(userId)).data.banned == true
          || get(/databases/$(database)/documents/users/$(userId)).data.deactivated == true
          || get(/databases/$(database)/documents/users/$(userId)).data.disabled == true
        );
    }

    function canUsePlatform() {
      return signedIn()
        && hasVerifiedEmail()
        && hasCompletedOnboarding()
        && !isBanned(request.auth.uid);
    }

    function canMessage() {
      return signedIn()
        && !isBanned(request.auth.uid);
    }

    function validBlogStatus() {
      return request.resource.data.status in ["published", "draft", "pending"];
    }

    function otherParticipantId(participants) {
      return participants[0] == request.auth.uid ? participants[1] : participants[0];
    }

    function userHasBlocked(userId, blockedUserId) {
      return userDocExists(userId)
        && get(/databases/$(database)/documents/users/$(userId)).data.keys().hasAny(["blockedUsers"])
        && blockedUserId in get(/databases/$(database)/documents/users/$(userId)).data.blockedUsers;
    }

    function isBlockedByAnyParticipant(participants) {
      return signedIn()
        && participants.size() == 2
        && (
          userHasBlocked(request.auth.uid, otherParticipantId(participants))
          || userHasBlocked(otherParticipantId(participants), request.auth.uid)
        );
    }

    function conversationExists(conversationId) {
      return exists(/databases/$(database)/documents/conversations/$(conversationId));
    }

    function isConversationParticipant(conversationId) {
      return signedIn()
        && conversationExists(conversationId)
        && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
    }

    function messageHasConversationId() {
      return resource.data.keys().hasAny(["conversationId"])
        && resource.data.conversationId is string;
    }

    function isMessageParticipant() {
      return signedIn()
        && (
          (
            messageHasConversationId()
            && isConversationParticipant(resource.data.conversationId)
          )
          || resource.data.senderId == request.auth.uid
          || resource.data.recipientId == request.auth.uid
        );
    }

    function validListingImages(images) {
      return images is list && images.size() >= 1 && images.size() <= 4;
    }

    function validListingBase(data) {
      return data.title is string
        && data.title.size() > 0
        && data.title.size() <= 140
        && data.author is string
        && data.author.size() > 0
        && data.author.size() <= 140
        && data.description is string
        && data.description.size() > 0
        && data.description.size() <= 3000
        && data.condition is string
        && data.condition.size() > 0
        && data.category is string
        && data.category.size() > 0
        && data.location is string
        && data.location.size() > 0
        && data.type in ["swap", "donate", "sell"]
        && data.price is number
        && data.price >= 0
        && (data.type != "sell" || data.price > 0)
        && (data.type == "sell" || data.price == 0)
        && validListingBase(data.images);
    }
  }
}
