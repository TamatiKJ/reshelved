rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function hasVerifiedEmail() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function userDocExists(userId) {
      return exists(/databases/$(database)/documents/users/$(userId));
    }

    function hasCompletedOnboarding() {
      return signedIn()
        && userDocExists(request.auth.uid)
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.onboardingStatus == "complete";
    }

    function isAdmin() {
      return signedIn()
        && (
          request.auth.token.admin == true
          || (
            userDocExists(request.auth.uid)
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true
          )
        );
    }

    function isBanned(userId) {
      return userDocExists(userId)
        && (
          get(/databases/$(database)/documents/users/$(userId)).data.banned == true
          || get(/databases/$(database)/documents/users/$(userId)).data.deactivated == true
          || get(/databases/$(database)/documents/users/$(userId)).data.disabled == true
        );
    }

    function canUsePlatform() {
      return signedIn()
        && hasVerifiedEmail()
        && hasCompletedOnboarding()
        && !isBanned(request.auth.uid);
    }

    function canMessage() {
      return signedIn()
        && !isBanned(request.auth.uid);
    }

    function validBlogStatus() {
      return request.resource.data.status in ["published", "draft", "pending"];
    }

    function otherParticipantId(participants) {
      return participants[0] == request.auth.uid ? participants[1] : participants[0];
    }

    function userHasBlocked(userId, blockedUserId) {
      return userDocExists(userId)
        && get(/databases/$(database)/documents/users/$(userId)).data.keys().hasAny(["blockedUsers"])
        && blockedUserId in get(/databases/$(database)/documents/users/$(userId)).data.blockedUsers;
    }

    function isBlockedByAnyParticipant(participants) {
      return signedIn()
        && participants.size() == 2
        && (
          userHasBlocked(request.auth.uid, otherParticipantId(participants))
          || userHasBlocked(otherParticipantId(participants), request.auth.uid)
        );
    }

    function conversationExists(conversationId) {
      return exists(/databases/$(database)/documents/conversations/$(conversationId));
    }

    function isConversationParticipant(conversationId) {
      return signedIn()
        && conversationExists(conversationId)
        && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
    }

    function messageHasConversationId() {
      return resource.data.keys().hasAny(["conversationId"])
        && resource.data.conversationId is string;
    }

    function isMessageParticipant() {
      return signedIn()
        && (
          (
            messageHasConversationId()
            && isConversationParticipant(resource.data.conversationId)
          )
          || resource.data.senderId == request.auth.uid
          || resource.data.recipientId == request.auth.uid
        );
    }

    function validListingImages(images) {
      return images is list && images.size() >= 1 && images.size() <= 4;
    }

    function validListingBase(data) {
      return data.title is string
        && data.title.size() > 0
        && data.title.size() <= 140
        && data.author is string
        && data.author.size() > 0
        && data.author.size() <= 140
        && data.description is string
        && data.description.size() > 0
        && data.description.size() <= 3000
        && data.condition is string
        && data.condition.size() > 0
        && data.category is string
        && data.category.size() > 0
        && data.location is string
        && data.location.size() > 0
        && data.type in ["swap", "donate", "sell"]
        && data.price is number
        && data.price >= 0
        && (data.type != "sell" || data.price > 0)
        && (data.type == "sell" || data.price == 0)
        && validListingImages(data.images);
    }

    function validListingCreate() {
      return canUsePlatform()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.active == true
        && request.resource.data.flagged == false
        && request.resource.data.flagCount == 0
        && request.resource.data.createdAt is number
        && request.resource.data.expiresAt is number
        && request.resource.data.listingDays is number
        && request.resource.data.listingDays >= 1
        && request.resource.data.listingDays <= 45
        && request.resource.data.expiresAt > request.time.toMillis()
        && request.resource.data.expiresAt <= request.time.toMillis() + (45 * 86400000)
        && validListingBase(request.resource.data);
    }

    function isOwnerListingEdit() {
      return canUsePlatform()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.active == resource.data.active
        && request.resource.data.expiresAt == resource.data.expiresAt
        && request.resource.data.listingDays == resource.data.listingDays
        && request.resource.data.flagged == resource.data.flagged
        && request.resource.data.flagCount == resource.data.flagCount
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          "title", "author", "description", "condition", "category", "categoryId", "categoryName", "type", "price", "images", "location", "updatedAt", "userName", "userPhoto"
        ])
        && validListingBase(request.resource.data);
    }

    function isOwnerListingRenewal() {
      return canUsePlatform()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(["active", "expiresAt", "renewedAt"])
        && request.resource.data.active == true
        && request.resource.data.expiresAt is number
        && request.resource.data.expiresAt > request.time.toMillis()
        && request.resource.data.expiresAt <= request.time.toMillis() + 3888000000;
    }

    function isOwnerListingDeactivation() {
      return signedIn()
        && hasVerifiedEmail()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(["active", "deactivatedOwner"])
        && request.resource.data.active == false
        && request.resource.data.deactivatedOwner == true;
    }

    function isListingReportFlagUpdate() {
      return canUsePlatform()
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(["flagged", "flagCount"])
        && request.resource.data.flagged == true
        && request.resource.data.flagCount is number
        && request.resource.data.flagCount == resource.data.flagCount + 1;
    }

    function isAdminListingUpdate() {
      return isAdmin()
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          "title", "author", "description", "condition", "category", "categoryId", "categoryName", "type", "price", "images", "location", "updatedAt", "userName", "userPhoto", "active", "expiresAt", "listingDays", "flagged", "flagCount", "deleted", "deletedAt", "deletedBy", "durationAdjustedAt"
        ]);
    }

    function validReportCreate() {
      return canUsePlatform()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0
        && request.resource.data.reason.size() <= 1000
        && request.resource.data.createdAt is number;
    }

    function validRatingCreate() {
      return canUsePlatform()
        && request.resource.data.fromUserId == request.auth.uid
        && request.resource.data.toUserId != request.auth.uid
        && request.resource.data.rating is number
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.createdAt is number;
    }

    function isSafeMessageMetaUpdate() {
      return canMessage()
        && isMessageParticipant()
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          "readBy", "deliveredTo", "deliveredAt", "deletedFor", "status", "messageStatus"
        ]);
    }

    function isDeleteForEveryone() {
      return canMessage()
        && resource.data.senderId == request.auth.uid
        && request.time.toMillis() < resource.data.createdAt + 1800000
        && request.resource.data.deleted == true
        && request.resource.data.deletedBy == request.auth.uid
        && request.resource.data.text == "This message was deleted"
        && request.resource.data.type == "text"
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          "deleted", "deletedAt", "deletedBy", "text", "type", "imageUrl", "imageData", "imageName", "imageSize", "storagePath", "mapUrl", "lat", "lng"
        ]);
    }

    function isSafeConversationUpdate() {
      return canMessage()
        && request.auth.uid in resource.data.participants
        && request.resource.data.participants == resource.data.participants
        && !isBlockedByAnyParticipant(resource.data.participants)
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          "lastMessage", "lastMessageAt", "lastMessageBy", "updatedAt", "hiddenFor", "deletedFor", "blockedUsers", "conversationKey", "unreadCount", "lastReadAt", "deliveredAt", "listingId", "listingTitle", "listingImage", "listingPrice", "listingType", "participantNames", "participantPhotos", "swapCompletion"
        ]);
    }

    function isAccountCleanupConversationUpdate() {
      return signedIn()
        && request.auth.uid in resource.data.participants
        && request.resource.data.participants == resource.data.participants
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(["participantNames", "participantPhotos"])
        && request.resource.data.participantNames[request.auth.uid] == "Deleted account"
        && request.resource.data.participantPhotos[request.auth.uid] == "";
    }

    function validNotificationBase() {
      return request.resource.data.keys().hasAll(["userId", "type", "subject", "message", "createdAt", "read"])
        && request.resource.data.userId is string
        && request.resource.data.subject is string
        && request.resource.data.message is string
        && request.resource.data.createdAt is number
        && request.resource.data.read == false
        && request.resource.data.type in ["system", "listing", "swap", "availability", "admin", "message"];
    }

    function validListingNotification() {
      return canUsePlatform()
        && validNotificationBase()
        && request.resource.data.type == "listing"
        && request.resource.data.keys().hasAny(["listingId"])
        && exists(/databases/$(database)/documents/listings/$(request.resource.data.listingId))
        && get(/databases/$(database)/documents/listings/$(request.resource.data.listingId)).data.userId == request.resource.data.userId
        && request.auth.uid != request.resource.data.userId;
    }

    function validPendingSignupCreate(sessionId) {
      return request.resource.data.keys().hasOnly(["sessionId", "email", "displayName", "location", "onboardingStatus", "createdAt", "updatedAt", "lastSentAt", "resendCount"])
        && request.resource.data.sessionId == sessionId
        && request.resource.data.email is string
        && request.resource.data.email.size() > 3
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 120
        && request.resource.data.location is string
        && request.resource.data.onboardingStatus == "pending"
        && request.resource.data.createdAt is number
        && request.resource.data.updatedAt is number
        && request.resource.data.lastSentAt is number;
    }

    function validPendingSignupResend(sessionId) {
      return resource.data.onboardingStatus == "pending"
        && request.resource.data.sessionId == sessionId
        && request.resource.data.email == resource.data.email
        && request.resource.data.displayName == resource.data.displayName
        && request.resource.data.location == resource.data.location
        && request.resource.data.onboardingStatus == "pending"
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt is number
        && request.resource.data.lastSentAt is number
        && (!request.resource.data.keys().hasAny(["resendCount"]) || request.resource.data.resendCount is number)
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(["updatedAt", "lastSentAt", "resendCount"]);
    }

    function validPendingSignupVerifiedUpdate() {
      return hasVerifiedEmail()
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.onboardingStatus == "password_required"
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.verifiedAt is number
        && request.resource.data.updatedAt is number
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(["onboardingStatus", "verifiedAt", "updatedAt", "uid"]);
    }

    function validPendingSignupCompleteUpdate() {
      return hasVerifiedEmail()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.onboardingStatus == "complete"
        && request.resource.data.completedAt is number
        && request.resource.data.updatedAt is number
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(["onboardingStatus", "completedAt", "updatedAt", "uid"]);
    }

    match /users/{userId} {
      allow create: if isOwner(userId)
        && request.resource.data.uid == userId
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.onboardingStatus in ["password_required", "complete", "pending"];

      allow read: if isOwner(userId) || isAdmin();

      allow update: if isAdmin()
        || (
          isOwner(userId)
          && hasVerifiedEmail()
          && request.resource.data.diff(resource.data).changedKeys().hasOnly([
            "displayName", "bio", "location", "phone", "photoURL", "updatedAt", "lastSeen", "blockedUsers", "online", "onboardingStatus", "email", "createdAt", "isAdmin", "deactivated", "deletedAt"
          ])
          && (
            request.resource.data.onboardingStatus == resource.data.onboardingStatus
            || (
              resource.data.onboardingStatus in ["pending", "password_required"]
              && request.resource.data.onboardingStatus in ["password_required", "complete"]
            )
          )
        );

      allow delete: if isAdmin();
    }

    match /pendingSignups/{sessionId} {
      allow create: if validPendingSignupCreate(sessionId);
      allow read: if isAdmin()
        || (resource.data.createdAt is number && resource.data.createdAt >= request.time.toMillis() - 3600000)
        || (signedIn() && resource.data.email == request.auth.token.email);
      allow update: if isAdmin() || validPendingSignupResend(sessionId) || validPendingSignupVerifiedUpdate() || validPendingSignupCompleteUpdate();
      allow delete: if isAdmin();
    }

    match /publicProfiles/{userId} {
      allow read: if true;
      allow create, update, delete: if (isOwner(userId) && hasVerifiedEmail()) || isAdmin();
    }

    match /listings/{listingId} {
      allow read: if true;
      allow create: if validListingCreate();
      allow update: if isOwnerListingEdit() || isOwnerListingRenewal() || isOwnerListingDeactivation() || isListingReportFlagUpdate() || isAdminListingUpdate();
      allow delete: if canUsePlatform() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /ratings/{ratingId} {
      allow read: if true;
      allow create: if validRatingCreate();
      allow update, delete: if isAdmin();
    }

    match /messages/{messageId} {
      allow read: if isAdmin() || isMessageParticipant();
      allow create: if canMessage()
        && request.resource.data.senderId == request.auth.uid
        && conversationExists(request.resource.data.conversationId)
        && request.auth.uid in get(/databases/$(database)/documents/conversations/$(request.resource.data.conversationId)).data.participants
        && !isBlockedByAnyParticipant(get(/databases/$(database)/documents/conversations/$(request.resource.data.conversationId)).data.participants);
      allow update: if isAdmin() || isSafeMessageMetaUpdate() || isDeleteForEveryone();
      allow delete: if isAdmin();
    }

    match /conversations/{conversationId} {
      allow read: if signedIn() && (request.auth.uid in resource.data.participants || isAdmin());
      allow create: if canMessage()
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants[0] != request.resource.data.participants[1]
        && !isBlockedByAnyParticipant(request.resource.data.participants);
      allow update: if isAdmin() || isSafeConversationUpdate() || isAccountCleanupConversationUpdate();
      allow delete: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow read, update, delete: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAdmin()
        || validListingNotification()
        || (canMessage() && validNotificationBase() && request.resource.data.type in ["system", "swap", "availability", "message"]);
    }

    match /reports/{reportId} {
      allow create: if validReportCreate();
      allow read, update, delete: if isAdmin();
    }

    match /contacts/{contactId} {
      allow create: if canMessage() && request.resource.data.userId == request.auth.uid;
      allow read, update: if isAdmin()
        || (
          canMessage()
          && (
            resource.data.userId == request.auth.uid
            || resource.data.sellerId == request.auth.uid
            || resource.data.buyerId == request.auth.uid
          )
        );
      allow delete: if isAdmin();
    }

    match /platform/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /blogPosts/{postId} {
      allow read: if resource.data.status == "published" || isAdmin();
      allow create: if isAdmin() && validBlogStatus();
      allow update: if isAdmin() && validBlogStatus();
      allow delete: if isAdmin();
    }

    match /blogCategories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /blogTags/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /locations/{locationId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
